// seccomp-политика решения кандидата (kafel, синтаксис nsjail). Всё, что не перечислено, разрешено:
// изоляцию дают пространства имён, cgroup и сброс capabilities, здесь — запас на случай дыры в ядре.
// Таблица kafel старая: новые вызовы — по номеру (с 424 номера одинаковы на x86_64 и aarch64),
// umount2 и kexec_file_load на aarch64 в ней нет — их и так закрывает отсутствие capabilities.
POLICY sbx {
  KILL {
    ptrace, process_vm_readv, process_vm_writev, kcmp,
    mount, pivot_root, chroot, unshare, setns,
    open_by_handle_at, name_to_handle_at,
    bpf, perf_event_open, userfaultfd, keyctl, add_key, request_key,
    init_module, finit_module, delete_module, kexec_load,
    reboot, swapon, swapoff, acct, quotactl, syslog, vhangup,
    settimeofday, clock_settime, clock_adjtime, adjtimex, sethostname, setdomainname, fanotify_init,
    // новый API монтирования: open_tree, move_mount, fsopen, fsconfig, fsmount, fspick, mount_setattr
    SYSCALL[428], SYSCALL[429], SYSCALL[430], SYSCALL[431], SYSCALL[432], SYSCALL[433], SYSCALL[442],
    // новые пространства имён через clone: CLONE_NEWNS|NEWCGROUP|NEWUTS|NEWIPC|NEWUSER|NEWPID|NEWNET
    clone { (clone_flags & 0x7e020000) != 0 }
  },
  ERRNO(38) {
    // clone3 (435): флаги в структуре в памяти не проверить — ENOSYS, glibc откатится на clone;
    // io_uring (425–427) — ENOSYS, libuv откатится на обычные вызовы
    SYSCALL[435], SYSCALL[425], SYSCALL[426], SYSCALL[427]
  },
  ERRNO(1) {
    // сети в песочнице нет (своё пустое сетевое пространство); сокеты не нужны ни Python, ни Node
    socket, socketpair
  }
}
USE sbx DEFAULT ALLOW
