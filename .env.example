# Образец окружения для docker compose: cp .env.example .env и заполнить.
# Compose читает .env из корня сам; .env в .gitignore — секреты в репозиторий не попадают.
# Пустое значение = значение по умолчанию из docker-compose.yml. DATABASE_URL задаёт compose, здесь не нужен.

# --- режим и секреты ---
# 0 — боевой режим; 1 — стенд жюри: засев пустой базы синтетикой, демо-вход, код входа в ответе, мок ФСП ID
DEMO=0
# перец HMAC кодов входа и демо-токенов: openssl rand -hex 32. Пусто — случайный на каждый старт, коды и входы сгорают при рестарте
SECRET_KEY=
# адрес стенда в браузере: redirect_uri ФСП ID и issuer мок-провайдера
PUBLIC_URL=http://localhost:8000
# токен организатора для импорта протоколов (страница /org, POST /api/achievements/import): openssl rand -hex 32.
# Пусто — импорт только пользователю с ролью admin
ORGANIZER_TOKEN=

# --- песочница задач на код ---
# общий секрет API ↔ песочница: openssl rand -hex 32. Пусто — тест идёт без задач на код
SANDBOX_TOKEN=
# одновременных прогонов (каждый — 1 CPU, до 256 МБ) и лимит CPU контейнера
SANDBOX_WORKERS=4
SANDBOX_CPUS=4

# --- почта (коды входа) ---
# пусто — письма не уходят; при DEMO=1 код приходит в ответе API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fsp-career.local

# --- ФСП ID (Keycloak OIDC) ---
# пусто + DEMO=1 — встроенный мок /mock-fsp-id; боевой — issuer realm, клиент и секрет
FSP_ID_ISSUER=
FSP_ID_CLIENT_ID=fsp-career
FSP_ID_CLIENT_SECRET=
# 1 — мок без DEMO; пусто — по DEMO
FSP_ID_MOCK=
# брокерские провайдеры на кнопках входа: alias:Название,alias:Название
FSP_ID_IDPS=

# --- LLM (необязательна: без неё — правила) ---
# none | ollama | openai_compatible | yandexgpt | gigachat
LLM_PROVIDER=none
OLLAMA_URL=http://host.docker.internal:11434/v1
# пусто — пресет провайдера (README «LLM»)
LLM_BASE_URL=
LLM_MODEL=
# none — без эмбеддингов
EMBED_MODEL=
LLM_TIMEOUT=60
# openai_compatible — Bearer, yandexgpt — API-ключ сервисного аккаунта
LLM_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=
# сертификат Минцифры для GigaChat (путь внутри контейнера)
LLM_CA_BUNDLE=

# --- OCR сканов резюме ---
# только свой vLLM (152-ФЗ: скан уходит в модель с ПДн), например http://vllm:8000/v1; пусто — выключен
OCR_URL=
OCR_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
OCR_API_KEY=
OCR_TIMEOUT=120
